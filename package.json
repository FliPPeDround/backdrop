{
  "name": "@backdrop/monorepo",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "web": "cd packages/web && pnpm dev",
    "mp": "cd packages/mp && pnpm dev wx",
    "mcp:dev": "pnpm --filter @backdrop/mcp run dev",
    "mcp:test": "pnpm --filter @backdrop/mcp run test",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "build:web": "pnpm --filter web run build",
    "deploy:web": "pnpm --package=netlify-cli@23 dlx netlify deploy --prod --filter @backdrop/web --no-build",
    "deploy:web:draft": "pnpm --package=netlify-cli@23 dlx netlify deploy --filter @backdrop/web --no-build",
    "release": "pnpm build:web && pnpm deploy:web",
    "up": "taze major -I",
    "postinstall": "npx simple-git-hooks"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:dev",
    "@types/node": "catalog:dev",
    "baseline-browser-mapping": "catalog:dev",
    "eslint": "catalog:dev",
    "eslint-plugin-format": "catalog:dev",
    "lint-staged": "catalog:dev",
    "simple-git-hooks": "catalog:dev",
    "taze": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
